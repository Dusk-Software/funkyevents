---
import { business, navigation } from '../data/site';
---

<footer class="site-footer">
	<div class="footer-top">
		<div class="footer-brand">
			<a href="/" class="brand brand--footer" aria-label="Funky Events home">
				<span class="brand__wordmark">FUNKY EVENTS <span>DECORATIONS & PARTY RENTALS</span></span>
			</a>
			<p>Decor, rentals, and thoughtful event planning.<br />Gather beautifully.</p>
		</div>
		<div class="footer-links">
			<p class="footer-heading">Take a look</p>
			{navigation.slice(1, 6).map((item) => <a href={item.href}>{item.label}</a>)}
		</div>
		<div class="footer-links">
			<p class="footer-heading">Say hello</p>
			<a href={`mailto:${business.email}`}>{business.email}</a>
			<a href={`tel:${business.phone.replace(/[^+\d]/g, '')}`}>{business.phone}</a>
			<a href={business.website} target="_blank" rel="noreferrer">funkyevents.net ↗</a>
			<span>Serving {business.serviceArea}.</span>
		</div>
		<div class="footer-cta">
			<p class="eyebrow">Have a date in mind?</p>
			<h2>Let’s make it<br /><em>mean something.</em></h2>
			<a class="button button--light" href="/contact/">Start a conversation <span aria-hidden="true">↗</span></a>
		</div>
	</div>
	<div class="footer-bottom">
		<span>© {new Date().getFullYear()} Funky Events. All good things gathered.</span>
		<div><a href="/contact/">Contact</a><a href={business.maps} target="_blank" rel="noreferrer">Google Maps ↗</a></div>
	</div>
</footer>
