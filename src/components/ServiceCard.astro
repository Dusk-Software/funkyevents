---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
	service: {
		title: string;
		slug: string;
		icon: 'rings' | 'sparkles' | 'heart' | 'flower' | 'calendar';
		image: ImageMetadata;
		description: string;
	};
	compact?: boolean;
}

const { service, compact = false } = Astro.props;
---

<article class:list={['service-card', compact && 'service-card--compact']}>
	<a class="service-card__image-link" href={`/services/#${service.slug}`} aria-label={`Learn about ${service.title}`}>
		<Image
			src={service.image}
			alt=""
			class="service-card__image"
			width={720}
			height={480}
			format="webp"
			quality={78}
			loading="lazy"
		/>
		<span class="service-card__icon"><Icon name={service.icon} /></span>
	</a>
	<div class="service-card__body">
		<p class="service-card__kicker">Made for your moment</p>
		<h3>{service.title}</h3>
		<p>{service.description}</p>
		<a class="text-link" href={`/services/#${service.slug}`}>Explore service <span aria-hidden="true">↗</span></a>
	</div>
</article>
