---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	items: Array<{
		title: string;
		category: string;
		image: ImageMetadata;
		alt: string;
	}>;
}

const { items } = Astro.props;
---

<div class="gallery-grid">
	{items.map((item, index) => (
		<figure class:list={['gallery-item', index % 4 === 1 && 'gallery-item--tall']}>
			<div class="gallery-item__image-wrap">
				<Image
					src={item.image}
					alt={item.alt}
					class="gallery-item__image"
					width={900}
					height={1100}
					format="webp"
					quality={78}
					loading="lazy"
				/>
			</div>
			<figcaption>
				<span>{item.category}</span>
				<strong>{item.title}</strong>
			</figcaption>
		</figure>
	))}
</div>
