---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/site';
---

<BaseLayout
	title="Event Planning Services | Funky Events"
	description="Event decoration, planning, and party rentals for weddings, birthdays, baby showers, traditional engagements, church events, graduation parties, and corporate events."
>
	<section class="page-hero">
		<div class="page-hero__inner">
			<p class="eyebrow">The kind of help that feels good</p>
			<h1>Big moments.<br /><em>Thoughtfully handled.</em></h1>
			<p class="page-hero__text">Event decoration and planning for the occasions below. Party rentals are also available.</p>
		</div>
	</section>

	<section class="section">
		{services.map((service) => (
			<article class="service-detail" id={service.slug}>
				<div class="service-detail__image">
					<div class="service-detail__photo">
						<Image src={service.image} alt={service.imageAlt} width={1100} height={850} format="webp" quality={80} loading="lazy" />
					</div>
				</div>
				<div class="service-detail__copy">
					<p class="eyebrow">A little less on your list</p>
					<h2>{service.title}</h2>
					<p>{service.details}</p>
					<h3>Thoughtfully taken care of</h3>
					<ul>{service.includes.map((item) => <li>{item}</li>)}</ul>
					<a class="text-link" href="/contact/">Let’s talk about it <span aria-hidden="true">↗</span></a>
				</div>
			</article>
		))}
	</section>

	<section class="final-cta">
		<p class="eyebrow">Not sure what you need yet?</p>
		<h2>That’s a lovely place to start.</h2>
		<p>Contact Josephine to discuss your celebration, event planning, decorations, and party rentals.</p>
		<a class="button button--light" href="/contact/">Tell us a little more <span aria-hidden="true">↗</span></a>
	</section>
</BaseLayout>
