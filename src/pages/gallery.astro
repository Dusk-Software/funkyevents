---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import { galleryItems } from '../data/site';

const categories = ['Event Setups', 'Decor & Backdrops', 'Tables & Party Details', 'Party Details'];
const categoryId = (category: string) => category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<BaseLayout
	title="Event Gallery | Funky Events"
	description="Browse event setups, balloon backdrops, table styling, and party details in the Funky Events portfolio."
>
	<section class="page-hero">
		<div class="page-hero__inner">
			<p class="eyebrow">Little things, lasting feelings</p>
			<h1>Gathered moments.<br /><em>Made to mean more.</em></h1>
			<p class="page-hero__text">A look at event setups, thoughtful details, and party pieces in the Funky Events portfolio.</p>
		</div>
	</section>

	<section class="section section--cream">
		<nav class="gallery-filter" aria-label="Gallery categories">
			{categories.map((category) => <a href={`#${categoryId(category)}`}>{category}</a>)}
		</nav>
		{categories.map((category) => (
			<section id={categoryId(category)} aria-labelledby={`heading-${categoryId(category)}`} style="padding-bottom: 4rem; scroll-margin-top: 2rem;">
				<div class="section-heading section-heading--left">
					<p class="eyebrow">A reason to gather</p>
					<h2 id={`heading-${categoryId(category)}`}>{category}</h2>
				</div>
				<GalleryGrid items={galleryItems.filter((item) => item.category === category)} />
			</section>
		))}
		<p class="sample-note">Portfolio photographs supplied by Funky Events.</p>
	</section>

	<section class="final-cta">
		<p class="eyebrow">Have a moment in mind?</p>
		<h2>We’d love to hear what you’re planning.</h2>
		<a class="button button--light" href="/contact/">Start a conversation <span aria-hidden="true">↗</span></a>
	</section>
</BaseLayout>
