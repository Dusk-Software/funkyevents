---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { business } from '../data/site';
---

<BaseLayout
	title="Contact Funky Events | Rhode Island Event Planning"
	description="Contact Josephine Ishioye at Funky Events to plan your Rhode Island celebration, decorations, or party rentals."
>
	<section class="page-hero">
		<div class="page-hero__inner">
			<p class="eyebrow">The start of something lovely</p>
			<h1>Tell us what<br /><em>you’re dreaming of.</em></h1>
			<p class="page-hero__text">Contact Josephine by email or phone to discuss your event, decorations, or party rentals.</p>
		</div>
	</section>

	<section class="section">
		<div class="contact-grid">
			<aside class="contact-copy">
				<p class="eyebrow">We’re all ears</p>
				<h2>Let’s make a little room for magic.</h2>
				<p>Reach out about a wedding, birthday, baby shower, traditional engagement, church event, graduation party, or corporate event.</p>
				<dl class="contact-info">
					<div><dt>Email</dt><dd><a href={`mailto:${business.email}`}>{business.email}</a></dd></div>
					<div><dt>Phone</dt><dd><a href={`tel:${business.phone.replace(/[^+\d]/g, '')}`}>{business.phone}</a></dd></div>
					<div><dt>Where</dt><dd>{business.serviceArea}</dd></div>
				</dl>
				<a class="text-link" href={business.maps} target="_blank" rel="noreferrer">Google Maps listing <span aria-hidden="true">↗</span></a>
			</aside>

			<form class="contact-form" action="https://formspree.io/f/mwloazad" method="POST">
				<h2>Tell us about your event.</h2>
				<p class="contact-form__intro">Share a few details and Josephine can follow up with you directly.</p>
				<input type="hidden" name="_subject" value="New event inquiry from Funky Events website" />
				<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" hidden />
				<div class="form-grid">
					<div class="field">
						<label for="name">Your name</label>
						<input id="name" name="name" autocomplete="name" required />
					</div>
					<div class="field">
						<label for="email">Email address</label>
						<input id="email" name="email" type="email" autocomplete="email" required />
					</div>
					<div class="field">
						<label for="phone">Phone <span>(optional)</span></label>
						<input id="phone" name="phone" type="tel" autocomplete="tel" />
					</div>
					<div class="field">
						<label for="date">Event date <span>(if known)</span></label>
						<input id="date" name="event_date" type="date" />
					</div>
					<div class="field">
						<label for="event-type">What are you celebrating?</label>
						<select id="event-type" name="event_type" required>
							<option value="" disabled selected>Select an event type</option>
							<option>Wedding</option>
							<option>Birthday</option>
							<option>Baby shower</option>
							<option>Traditional engagement</option>
							<option>Church event</option>
							<option>Graduation party</option>
							<option>Corporate event</option>
						</select>
					</div>
					<div class="field">
						<label for="guests">Estimated guest count <span>(optional)</span></label>
						<input id="guests" name="guest_count" type="number" min="1" inputmode="numeric" />
					</div>
					<div class="field field--full">
						<label for="message">Tell us a little more</label>
						<textarea id="message" name="message" placeholder="Share what you’re planning or what you’d like to ask." required></textarea>
					</div>
				</div>
				<button class="button" type="submit">Send your inquiry <span aria-hidden="true">↗</span></button>
			</form>
		</div>
		<div class="contact-bottom">
			<div>
				<p class="eyebrow">Directions & reviews</p>
				<h3>Funky Events on Google Maps.</h3>
				<p class="contact-description">We serve Rhode Island and surrounding areas. Visit our Google listing for directions and reviews.</p>
			</div>
			<a class="map-placeholder" href={business.maps} target="_blank" rel="noreferrer" aria-label="Open the Funky Events Google Maps listing">
				<span class="map-placeholder__card"><Icon name="pin" /><span>Funky Events<br /><strong>Open Google Maps listing ↗</strong></span></span>
			</a>
		</div>
	</section>
</BaseLayout>
