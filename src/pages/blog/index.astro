---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout
	title="The Gathering Guide | Funky Events"
	description="The Gathering Guide from Funky Events. No articles are currently published."
	currentPath="/blog/"
>
	<section class="page-hero">
		<div class="page-hero__inner">
			<p class="eyebrow">A few good things to know</p>
			<h1>The Gathering<br /><em>Guide.</em></h1>
			<p class="page-hero__text">There are no published articles yet.</p>
		</div>
	</section>
	<section class="section section--cream">
		<div class="blog-grid">
			{posts.map((post) => (
				<article class="blog-card">
					<div class="blog-card__meta"><span>{post.data.category}</span><time datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</time></div>
					<h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
					<p class="blog-card__description">{post.data.description}</p>
					<a class="text-link" href={`/blog/${post.id}/`}>Read the note <span aria-hidden="true">↗</span></a>
				</article>
			))}
		</div>
		{posts.length === 0 && <p>There are no published articles yet. Please check back later.</p>}
	</section>
</BaseLayout>
