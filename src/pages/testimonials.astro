---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteCard from '../components/QuoteCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { testimonials } from '../data/site';
---

<BaseLayout
	title="Google Reviews | Funky Events"
	description="Read brief excerpts from Google reviews about bridal showers hosted by Funky Events."
>
	<section class="page-hero">
		<div class="page-hero__inner">
			<p class="eyebrow">Shared on Google</p>
			<h1>Kind words,<br /><em>graciously shared.</em></h1>
			<p class="page-hero__text">A couple of brief excerpts from Google reviews about bridal showers.</p>
		</div>
	</section>
	<section class="section section--cream">
		<div class="review-heading">
			<SectionHeading align="left" eyebrow="Google reviews" title="Bridal shower reviews." text="Brief excerpts shown with reviewers’ Google display names." />
			<a class="button button--outline" href="https://maps.app.goo.gl/6dbn5ExU9MuMPyy57" target="_blank" rel="noreferrer">Read reviews on Google <span aria-hidden="true">↗</span></a>
		</div>
		<div class="quote-grid">
			{testimonials.map((testimonial) => <QuoteCard {...testimonial} />)}
		</div>
	</section>
	<section class="final-cta">
		<p class="eyebrow">Let’s make your own story</p>
		<h2>We’d be honored to help.</h2>
		<a class="button button--light" href="/contact/">Tell us about your event <span aria-hidden="true">↗</span></a>
	</section>
</BaseLayout>
